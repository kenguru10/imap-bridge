# Base URL of the deployed cloud-mail worker (the same URL you use for the web UI)
CLOUD_MAIL_WORKER_URL=https://mail.yourdomain.com

# IMAP server listen address/port
IMAP_HOST=0.0.0.0
IMAP_PORT=143

# SMTP submission server listen address/port
SMTP_HOST=0.0.0.0
SMTP_PORT=587

# SMTP server behavior
# Require STARTTLS/TLS before allowing AUTH (recommended for remote hosts)
SMTP_REQUIRE_TLS=false
# Comma-separated list of allowed auth mechanisms. Outlook mainly needs PLAIN or LOGIN.
SMTP_AUTH_METHODS=PLAIN,LOGIN
# Maximum message size in bytes (default 50 MiB)
SMTP_MAX_MESSAGE_SIZE=52428800
# Maximum concurrent SMTP connections
SMTP_MAX_CLIENTS=100

# Whether the bridge should add a copy of each outbound message to the Sent folder.
# Disable this if your mail client already appends sent copies itself, to avoid duplicates.
SMTP_SAVE_SENT_COPY=true

# Sender display-name overrides for outbound mail, e.g. force "Amilora" instead of "admin"
# Format: email=Name,email2=Name2 (address matching is case-insensitive)
#SENDER_NAME_OVERRIDES=admin@amilora.net=Amilora

# Outbound SMTP relay provider
# - worker  -> forward mail through the cloud-mail worker's /api/email/send (default)
# - resend  -> relay mail through Resend's SMTP server
SMTP_RELAY_PROVIDER=worker

# Resend SMTP settings (only used when SMTP_RELAY_PROVIDER=resend)
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_SECURE=false
RESEND_SMTP_USER=resend
RESEND_API_KEY=re_xxxxxxxx
# Pull real sent emails from the Resend API (GET /emails) into the IMAP Sent
# folder. Enabled by default when RESEND_API_KEY is set; set false to only use
# it for SMTP relay.
RESEND_SYNC_SENT=true
# Page size for the Resend sent-sync (max 100)
RESEND_SENT_PAGE_SIZE=100

# How often to poll the worker for new mail (ms)
POLL_INTERVAL_MS=30000

# KV-write reduction: batch \Seen reports to the worker on a timer (ms)
SEEN_FLUSH_INTERVAL_MS=60000
SEEN_FLUSH_MAX_BATCH=200
# Skip re-authentication (worker /api/login) for known users within this window (ms)
AUTH_RECHECK_MS=600000
# Where seen-report cache files are stored (kept across restarts;
# docker-compose mounts ./data -> /data, use PERSIST_DIR=/data in the deployment .env)
PERSIST_DIR=/data

# Maximum messages to load per folder on startup
MAX_INITIAL_MESSAGES=500

# Optional: passphrase if the TLS key file is encrypted (omit if the key is unencrypted)
# TLS_KEY_PASSPHRASE=your-passphrase

# Optional: absolute paths to TLS key/cert if you want to encrypt the connection.
#
# IMAP:
#   - IMAP_PORT=143 + TLS cert  -> STARTTLS (Outlook can use "STARTTLS" / "TLS")
#   - IMAP_PORT=993 + TLS cert  -> implicit TLS / IMAPS (Outlook "SSL")
#
# Example for IMAPS:
#   IMAP_PORT=993
#   TLS_KEY_PATH=/app/certs/key.pem
#   TLS_CERT_PATH=/app/certs/cert.pem
#
# SMTP:
#   - SMTP_PORT=587 + TLS cert  -> STARTTLS (Outlook "STARTTLS" / "TLS")
#   - SMTP_PORT=465 + TLS cert  -> implicit TLS / SMTPS (Outlook "SSL")
#
# For local testing you can leave these empty (plain text).
# For remote/production you should provide a real certificate (e.g. Let's Encrypt).
# Self-signed certificates will trigger a warning in Outlook that the user must accept.
# TLS_KEY_PATH=/path/to/key.pem
# TLS_CERT_PATH=/path/to/cert.pem
